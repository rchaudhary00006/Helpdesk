# --- Shared ---
# Do not set NODE_ENV here: Next.js manages it, and prod deploys set it per-process.
DATABASE_URL=postgresql://helpdesk:helpdesk@localhost:5432/helpdesk?schema=public
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Generate a real one for prod: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
UPLOAD_DIR=../../storage/uploads
MAX_UPLOAD_MB=15

# --- Worker / email ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Helpdesk <support@helpdesk.local>"
# Solved tickets auto-close after this many hours of inactivity
AUTO_CLOSE_AFTER_HOURS=96

# --- Web ---
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# --- Email-to-ticket (see docs/email-to-ticket.md) ---
# The support inbox customers write to / reply to. Set as Reply-To on outgoing mail.
SUPPORT_EMAIL=support@helpdesk.local
# Enables POST /api/inbound/email. Generate: openssl rand -hex 24
INBOUND_EMAIL_SECRET=
# Comma-separated sender domains allowed to open tickets (empty = anyone)
INBOUND_ALLOWED_DOMAINS=
INBOUND_AUTO_CREATE_USERS=true
INBOUND_MAX_PER_SENDER_PER_HOUR=20
# Optional IMAP polling of the support mailbox (instead of a provider webhook).
# Local test server: docker compose --profile imap up -d  → IMAP_HOST=localhost IMAP_PORT=3143 IMAP_SECURE=false
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=30
