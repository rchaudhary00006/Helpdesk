generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Keep enums in sync with packages/shared/src/enums.ts
enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

enum TicketStatus {
  NEW
  OPEN
  PENDING
  ON_HOLD
  SOLVED
  CLOSED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketType {
  QUESTION
  INCIDENT
  PROBLEM
  TASK
}

enum Channel {
  WEB
  EMAIL
  API
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  domain    String?  @unique
  users     User[]
  tickets   Ticket[]
  createdAt DateTime @default(now())
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String
  passwordHash   String
  role           Role          @default(CUSTOMER)
  active         Boolean       @default(true)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  groups           GroupMember[]
  requestedTickets Ticket[]       @relation("Requester")
  assignedTickets  Ticket[]       @relation("Assignee")
  comments         Comment[]
  attachments      Attachment[]
  auditLogs        AuditLog[]
  notifications    Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, active])
}

model Group {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  members     GroupMember[]
  tickets     Ticket[]
  createdAt   DateTime      @default(now())
}

model GroupMember {
  userId  String
  groupId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
}

model Ticket {
  id      String       @id @default(cuid())
  /// Human-friendly reference shown to users ("#1042"); id stays the internal key.
  number  Int          @unique @default(autoincrement())
  subject String
  status  TicketStatus @default(NEW)
  priority Priority    @default(NORMAL)
  type    TicketType   @default(QUESTION)
  channel Channel      @default(WEB)
  tags    String[]     @default([])

  requesterId    String
  requester      User          @relation("Requester", fields: [requesterId], references: [id])
  assigneeId     String?
  assignee       User?         @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  groupId        String?
  group          Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // SLA — targets are computed when the ticket is created / re-prioritised.
  firstResponseDueAt    DateTime?
  resolutionDueAt       DateTime?
  firstRespondedAt      DateTime?
  firstResponseBreached Boolean   @default(false)
  resolutionBreached    Boolean   @default(false)
  /// True when the targets above were computed in business hours (shown to agents)
  slaBusinessHours      Boolean   @default(false)

  resolvedAt DateTime?
  closedAt   DateTime?

  comments      Comment[]
  attachments   Attachment[]
  auditLogs     AuditLog[]
  inboundEmails InboundEmail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([assigneeId, status])
  @@index([groupId, status])
  @@index([requesterId, updatedAt])
  @@index([organizationId])
}

model Comment {
  id          String       @id @default(cuid())
  ticketId    String
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  body        String
  /// false = internal note, never visible to customers
  isPublic    Boolean      @default(true)
  /// How the comment arrived (web UI vs. email reply)
  via         Channel      @default(WEB)
  attachments Attachment[]
  createdAt   DateTime     @default(now())

  @@index([ticketId, createdAt])
}

model Attachment {
  id         String   @id @default(cuid())
  /// Null until the upload is attached to a ticket/comment.
  ticketId   String?
  ticket     Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id])
  fileName   String
  mimeType   String
  size       Int
  storageKey String   @unique
  createdAt  DateTime @default(now())

  @@index([commentId])
  @@index([uploaderId, ticketId])
}

enum InboundStatus {
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

/// Every inbound email we receive: dedupes provider retries (Message-ID) and answers
/// "why didn't my email become a ticket?" for admins.
model InboundEmail {
  id          String        @id @default(cuid())
  messageId   String        @unique
  fromAddress String
  subject     String
  status      InboundStatus @default(PROCESSING)
  /// Outcome detail: "created", "replied", "auto-reply", "rate limited", error message, …
  reason      String?
  ticketId    String?
  ticket      Ticket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  receivedAt  DateTime      @default(now())

  @@index([fromAddress, receivedAt])
  @@index([receivedAt])
}

model SlaPolicy {
  id                   String            @id @default(cuid())
  priority             Priority          @unique
  firstResponseMinutes Int
  resolutionMinutes    Int
  /// Null = clock runs 24/7 (calendar time)
  scheduleId           String?
  schedule             BusinessSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  updatedAt            DateTime          @updatedAt
}

/// Working hours used by SLA policies. Times are wall-clock in `timezone`.
model BusinessSchedule {
  id          String      @id @default(cuid())
  name        String      @unique
  /// IANA zone, e.g. "Asia/Kolkata"
  timezone    String
  /// [{ day: 0-6 (Sun=0), start: "HH:MM", end: "HH:MM" }] — multiple per day allowed (split shifts)
  intervals   Json
  holidays    Holiday[]
  slaPolicies SlaPolicy[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Holiday {
  id         String           @id @default(cuid())
  scheduleId String
  schedule   BusinessSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  /// Local date "YYYY-MM-DD" in the schedule's timezone
  date       String
  name       String

  @@unique([scheduleId, date])
}

model AuditLog {
  id        String   @id @default(cuid())
  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// Null for system actions (SLA worker, automations)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  changes   Json?
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketId  String?
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}
